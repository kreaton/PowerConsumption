<Window x:Class="PowerConsumption.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PowerConsumption.Wpf.Controls"
        Icon="app.ico"
        Title="PowerConsumption"
        Width="1320" Height="900" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- What is shown, and the app's commands -->
        <Grid DockPanel.Dock="Top" Margin="14,10,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SetupText" VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Margin="0,0,6,0" Click="OnRefreshClick" ToolTip="Read the database again, e.g. after MultiApiFetcher has run" />
                <Button x:Name="ExportButton" Content="Export CSV…" Margin="0,0,6,0" Click="OnExportClick" IsEnabled="False" />
                <Button x:Name="SettingsButton" Content="Settings…" Margin="0,0,6,0" Click="OnSettingsClick" />
                <Button Content="About…" Click="OnAboutClick" />
            </StackPanel>
        </Grid>

        <!-- Granularity and period navigation -->
        <Grid DockPanel.Dock="Top" Margin="14,6,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Bars per" VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton x:Name="HourRadio" GroupName="Granularity" Content="Hour" MinWidth="70" Checked="OnGranularityChecked" />
                <RadioButton x:Name="DayRadio" GroupName="Granularity" Content="Day" MinWidth="70" Checked="OnGranularityChecked" />
                <RadioButton x:Name="MonthRadio" GroupName="Granularity" Content="Month" MinWidth="80" Checked="OnGranularityChecked" />
                <RadioButton x:Name="YearRadio" GroupName="Granularity" Content="Year" MinWidth="70" Checked="OnGranularityChecked" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Content="◀" Width="40" Click="OnPrevClick" ToolTip="Previous period" />
                <TextBlock x:Name="PeriodText" MinWidth="260" TextAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" FontWeight="SemiBold" Margin="10,0" />
                <Button x:Name="NextButton" Content="▶" Width="40" Click="OnNextClick" ToolTip="Next period" />
                <Button x:Name="LatestButton" Content="Latest" Margin="10,0,0,0" Click="OnLatestClick" ToolTip="Go to the newest data" />
                <Button x:Name="UpButton" Content="Zoom out" Margin="6,0,0,0" Click="OnUpClick" ToolTip="Show the period around this one (double-click a bar to zoom in)" />
                <Button x:Name="RangeButton" Content="Dates…" Margin="6,0,0,0" Click="OnRangeClick" ToolTip="Show any range of dates" />
            </StackPanel>

            <!-- Dates…: pick any from/to dates, or a quick range ending at the newest data. -->
            <Popup x:Name="RangePopup" PlacementTarget="{Binding ElementName=RangeButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Margin="0,4,0,0" Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <DatePicker x:Name="FromPicker" Grid.Column="1" Margin="0,0,0,6" SelectedDateFormat="Short" />
                            <TextBlock Grid.Row="1" Text="To (incl.)" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <DatePicker x:Name="ToPicker" Grid.Row="1" Grid.Column="1" SelectedDateFormat="Short" />
                        </Grid>
                        <TextBlock x:Name="RangeError" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" MaxWidth="260" Margin="0,6,0,0" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Last" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.75" />
                            <Button Content="7 days" Tag="7d" Click="OnQuickRangeClick" Margin="0,0,4,0" />
                            <Button Content="30 days" Tag="30d" Click="OnQuickRangeClick" Margin="0,0,4,0" />
                            <Button Content="12 months" Tag="12m" Click="OnQuickRangeClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Show" IsDefault="True" MinWidth="80" Click="OnApplyRangeClick"
                                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0" />
                            <Button Content="Cancel" MinWidth="80" Click="OnCancelRangeClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ExclEvCheck" Content="Excl. EV" Margin="0,0,12,0" Checked="OnVatChanged" Unchecked="OnVatChanged"
                          ToolTip="Leave the EV charger out of consumption, cost and average price" />
                <CheckBox x:Name="VatCheck" Content="Incl. VAT" Checked="OnVatChanged" Unchecked="OnVatChanged" />
            </StackPanel>
        </Grid>

        <!-- Key figures -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="10,4,10,0">
            <Border Style="{StaticResource TileBorder}">
                <StackPanel>
                    <TextBlock x:Name="KwhCaption" Style="{StaticResource TileCaption}" Text="Consumption" />
                    <TextBlock x:Name="KwhValue" Style="{StaticResource TileValue}" Text="–" />
                    <TextBlock x:Name="KwhSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel>
                    <TextBlock x:Name="CostCaption" Style="{StaticResource TileCaption}" Text="Cost" />
                    <TextBlock x:Name="CostValue" Style="{StaticResource TileValue}" Text="–" />
                    <TextBlock x:Name="CostSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel>
                    <TextBlock x:Name="AvgCaption" Style="{StaticResource TileCaption}" Text="Average price" />
                    <TextBlock x:Name="AvgValue" Style="{StaticResource TileValue}" Text="–" />
                    <TextBlock x:Name="AvgSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileCaption}" Text="EV charging" />
                    <TextBlock x:Name="EvValue" Style="{StaticResource TileValue}" Text="–" />
                    <TextBlock x:Name="EvSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileBorder}">
                <StackPanel>
                    <TextBlock x:Name="WeatherCaption" Style="{StaticResource TileCaption}" Text="Weather" />
                    <TextBlock x:Name="WeatherValue" Style="{StaticResource TileValue}" Text="–" />
                    <TextBlock x:Name="WeatherSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="12,8,12,8">
            <TabItem Header="Consumption (kWh)">
                <c:BarChart x:Name="KwhChart" Margin="6" />
            </TabItem>
            <TabItem Header="Cost (kr)">
                <c:BarChart x:Name="CostChart" Margin="6" />
            </TabItem>
            <TabItem Header="EV charging">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>
                    <c:BarChart x:Name="EvChart" />
                    <TextBlock Grid.Row="1" Text="Charging sessions started in the period" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <DataGrid x:Name="SessionGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="170" />
                            <DataGridTextColumn Header="End" Binding="{Binding End}" Width="170" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="kWh" Binding="{Binding Kwh}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Cost kr" Binding="{Binding Cost}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="kr/kWh" Binding="{Binding Price}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Charger" Binding="{Binding Device}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Climate">
                <c:BarChart x:Name="ClimateChart" Margin="6" />
            </TabItem>
            <TabItem Header="Table">
                <DataGrid x:Name="TableGrid" Margin="6" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          CanUserSortColumns="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Number columns are sized to their content; the long headers have a line break so they stay narrow. -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="170" />
                        <DataGridTextColumn Header="kWh" Binding="{Binding Kwh}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="EV kWh" Binding="{Binding EvKwh}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Household&#10;kWh" Binding="{Binding OtherKwh}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="kr/kWh" Binding="{Binding Price}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Cost kr" Binding="{Binding Cost}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="EV kr" Binding="{Binding EvCost}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Household&#10;kr" Binding="{Binding OtherCost}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Household&#10;kr/kWh" Binding="{Binding OtherPrice}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Sessions" Binding="{Binding Sessions}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Avg °C" Binding="{Binding AvgTemp}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Min °C" Binding="{Binding MinTemp}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Max °C" Binding="{Binding MaxTemp}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Rain mm" Binding="{Binding Precipitation}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Deg. days" Binding="{Binding DegreeDays}" Width="Auto" MinWidth="64" ElementStyle="{StaticResource NumberCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
