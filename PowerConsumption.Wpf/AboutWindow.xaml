<Window x:Class="PowerConsumption.Wpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="About PowerConsumption"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Hyperlinks open in the default browser via OnLink; the texts mirror CREDITS.md. -->
    <StackPanel Margin="28,24,28,20" MaxWidth="480">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="64" Height="64" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="18,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="PowerConsumption" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="UpdateButton" Content="Check for updates" Padding="12,4" Click="OnCheckForUpdates" />
            <TextBlock x:Name="UpdateStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="300" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="Electricity consumption and cost, EV charging and weather by hour, day, month and year, read from the local electricity_db database that MultiApiFetcher keeps up to date." />

        <TextBlock Margin="0,14,0,0" FontWeight="SemiBold">
            <Run x:Name="CopyrightText" /><Run Text=" · " />
            <Hyperlink NavigateUri="https://github.com/kreaton/PowerConsumption/blob/main/LICENSE.txt" RequestNavigate="OnLink">MIT License</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
            <Hyperlink NavigateUri="https://github.com/kreaton/PowerConsumption" RequestNavigate="OnLink">github.com/kreaton/PowerConsumption</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Idea and ownership: Per Hejndorf. Code written with Claude (Anthropic) in Claude Code." />

        <TextBlock Margin="0,16,0,4" Text="Data" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap">
            <Run Text="Meter readings:" />
            <Hyperlink NavigateUri="https://eloverblik.dk" RequestNavigate="OnLink">Eloverblik</Hyperlink>
            <Run Text="(Energinet)" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap">
            <Run Text="Prices, tariffs and taxes:" />
            <Hyperlink NavigateUri="https://stromligning.dk" RequestNavigate="OnLink">Strømligning</Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap">
            <Run Text="EV charging:" />
            <Hyperlink NavigateUri="https://docs.zaptec.com" RequestNavigate="OnLink">Zaptec Cloud API</Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap">
            <Run Text="Weather:" />
            <Hyperlink NavigateUri="https://open-meteo.com" RequestNavigate="OnLink">Weather data by Open-Meteo.com</Hyperlink>
            <Run Text="(" /><Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/" RequestNavigate="OnLink">CC BY 4.0</Hyperlink><Run Text=")" />
        </TextBlock>

        <TextBlock Margin="0,14,0,4" Text="Built with" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap">
            <Hyperlink NavigateUri="https://dotnet.microsoft.com" RequestNavigate="OnLink">.NET 10 and WPF</Hyperlink><Run Text=" · " />
            <Hyperlink NavigateUri="https://github.com/DapperLib/Dapper" RequestNavigate="OnLink">Dapper</Hyperlink><Run Text=" · " />
            <Hyperlink NavigateUri="https://mysqlconnector.net" RequestNavigate="OnLink">MySqlConnector</Hyperlink><Run Text=" · " />
            <Hyperlink NavigateUri="https://mariadb.org" RequestNavigate="OnLink">MariaDB</Hyperlink>
        </TextBlock>

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Zaptec is a trademark of Zaptec AS. This project is not affiliated with or endorsed by Zaptec, Energinet, Strømligning or Open-Meteo." />

        <Button Content="OK" IsDefault="True" IsCancel="True" MinWidth="96" Margin="0,20,0,0"
                HorizontalAlignment="Right" Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>
