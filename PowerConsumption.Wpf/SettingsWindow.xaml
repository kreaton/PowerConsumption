<Window x:Class="PowerConsumption.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico"
        Title="Settings" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="Database (electricity_db, filled by MultiApiFetcher)" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Server" VerticalAlignment="Center" />
            <TextBox x:Name="ServerBox" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="10,0,8,0" />
            <TextBox x:Name="PortBox" Grid.Column="3" Margin="0,3" />

            <TextBlock Grid.Row="1" Text="Database" VerticalAlignment="Center" />
            <TextBox x:Name="DatabaseBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3" />

            <TextBlock Grid.Row="2" Text="User" VerticalAlignment="Center" />
            <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3" />
        </Grid>

        <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Password" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Margin="0,3" />
        </Grid>
        <TextBlock x:Name="PasswordHint" Margin="110,2,0,0" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
            <Button x:Name="ConnectButton" Content="Connect" MinWidth="100" Click="OnConnectClick" />
            <TextBlock x:Name="ConnectStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
        </StackPanel>

        <TextBlock Text="What to show" FontWeight="SemiBold" Margin="0,18,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Meter" VerticalAlignment="Center" />
            <ComboBox x:Name="MeterCombo" Grid.Column="1" Margin="0,3" DisplayMemberPath="Display" />
            <TextBlock Grid.Row="1" Text="EV charger" VerticalAlignment="Center" />
            <ComboBox x:Name="ChargerCombo" Grid.Row="1" Grid.Column="1" Margin="0,3" DisplayMemberPath="Display" />
            <TextBlock Grid.Row="2" Text="Weather" VerticalAlignment="Center" />
            <ComboBox x:Name="WeatherCombo" Grid.Row="2" Grid.Column="1" Margin="0,3" DisplayMemberPath="Display" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" MinWidth="90" IsDefault="True" Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="Cancel" MinWidth="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
