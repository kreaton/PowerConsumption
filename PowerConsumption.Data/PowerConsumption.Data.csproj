<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the app needs from electricity_db (the database MultiApiFetcher fills):
    Dapper queries for hourly consumption, prices, EV charging and weather, and their
    aggregation into Danish hours, days, months and years. No UI dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PowerConsumption.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerConsumption.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
